  .brand-row { display: flex; align-items: center; justify-content: space-between; margin-bottom: 60px; }
  .brand { display: flex; align-items: center; font-family: 'Fraunces', serif; font-weight: 600; font-size: 19px; }
  .brand-mark { width: 28px; height: 28px; margin-right: 10px; }
