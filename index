<body>
<div class="wrap">

  <header>
    <div class="brand-row">
      <div class="brand">
        <svg class="brand-mark" viewBox="0 0 28 28">
          <circle cx="14" cy="14" r="13" fill="none" stroke="#5B6FE8" stroke-width="1.5"/>
