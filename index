  .lede { font-size: 17px; color: var(--ink-soft); max-width: 560px; }

  section { padding: 56px 0; border-top: 1px solid var(--line); }
  h2 { font-size: 26px; margin-bottom: 16px; }
  p { color: var(--ink-soft); font-size: 15.5px; margin-bottom: 14px; max-width: 600px; }
  p:last-child { margin-bottom: 0; }
  strong { color: var(--ink); font-weight: 600; }

  .husbandry-figure { margin: 28px 0; }
  .husbandry-figure img { width: 100%; max-width: 380px; display: block; border-radius: 4px; border: 1px solid var(--line); }
  .husbandry-figure figcaption { font-size: 13px; color: var(--ink-soft); margin-top: 10px; max-width: 380px; }

